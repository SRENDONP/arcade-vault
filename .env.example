# Contact form (SPEC 03) — copy to .env.local and fill in.
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# With onboarding@resend.dev, Resend only delivers to the email that owns the account.
CONTACT_FROM_EMAIL="Arcade Vault <onboarding@resend.dev>"
# Team inbox. Must be the Resend account email until a domain is verified.
CONTACT_TO_EMAIL=

# Supabase (SPEC 04) — Project Settings → API.
# Use the "publishable" key (sb_publishable_…), not the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
