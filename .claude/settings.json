{
  "permissions": {
    "deny": [
      "Edit(references/arkanoid/**)",
      "Edit(references/asteroids/**)",
      "Edit(references/claude-tetris/**)",
      "Edit(references/home-about/**)",
      "Edit(references/snake/**)",
      "Edit(references/templates/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-and-lint.mjs\"",
            "timeout": 60,
            "statusMessage": "Prettier + ESLint..."
          }
        ]
      }
    ]
  }
}
